{
  "name": "gatekeeper-senpi",
  "main": ".wrangler/validate/src/senpi.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-08-08",

  // `global_fetch_strictly_public` is the real SSRF boundary for this Worker. The Senpi endpoint and
  // authorization server are both public, and the fixed-issuer policy in `senpi.ts` allows only those
  // two origins for outbound OAuth/MCP. This flag makes workerd reject reserved ranges after DNS
  // resolution, which is the only place the check can be sound.
  "compatibility_flags": [
    "allow_irrevocable_stub_storage",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["SenpiAccount", "SenpiGatekeeperImpl"]
    }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }
  ],
  "vars": {
    "MCP_ALLOW_INSECURE": "false",
    "MCP_CLIENT_NAME": "Hoff OS Senpi Research",
    "SENPI_ENABLED": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
